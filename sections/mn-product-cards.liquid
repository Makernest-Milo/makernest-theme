{%- assign s = section.settings -%}
{%- assign c = s.collection -%}
<section class="mn" id="{{ s.anchor | default: section.id }}" style="padding: 3.2rem 0;">
  <div class="mn-wrap" style="display: flex; flex-direction: column; gap: 2rem;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.2rem;">
      <h2 class="mn-h3" style="font-size: 3.6rem;">{{ s.heading | default: c.title | escape }}</h2>
      {%- if s.text != blank -%}<div style="max-width: 46ch;">{{ s.text }}</div>{%- endif -%}
    </div>
    {%- if c != blank and c.products_count > 0 -%}
      <div class="mn-grid" style="grid-template-columns: repeat(auto-fit, minmax({% if s.big %}26rem{% else %}22rem{% endif %}, 1fr)); gap: 1.8rem;">
        {%- for p in c.products limit: s.limit -%}
          {%- liquid
            assign mn = p.metafields.makernest
            assign level = mn.level.value
            assign coming = false
            if mn.status.value == 'coming'
              assign coming = true
            endif
          -%}
          <article style="display: flex; flex-direction: column; gap: 1.2rem;{% unless s.big %} border: .2rem solid var(--mn-ink); border-radius: 1.8rem; padding: 1.8rem;{% endunless %}">
            <a href="{{ p.url }}" class="{% if level != blank %}mn-level--{{ level }}{% else %}mn-tint{% endif %}" style="display: flex; align-items: center; justify-content: center; border-radius: {% if s.big %}2.2rem{% else %}1.2rem{% endif %}; aspect-ratio: {% if s.big %}1 / 1{% else %}4 / 3{% endif %}; overflow: hidden; text-decoration: none;">
              {%- if p.featured_media != blank -%}
                {{ p.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 800', style: 'width:100%;height:100%;object-fit:cover;' }}
              {%- else -%}
                <span style="font-family: var(--mn-display); font-weight: 800; font-size: 5.2rem;">{{ p.title | escape }}</span>
              {%- endif -%}
            </a>
            {%- if mn.card_label != blank -%}<span class="mn-mono" style="font-size: 1.2rem; letter-spacing: .1rem;">{{ mn.card_label.value | upcase | escape }}</span>{%- endif -%}
            <h3 style="margin: 0; font-family: var(--mn-display); font-size: {% if s.big %}2.8rem{% else %}1.9rem{% endif %};"><a href="{{ p.url }}" style="text-decoration: none;">{{ p.title | escape }}</a></h3>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: auto;">
              <strong style="font-size: 2rem;">{{ p.price | money }}</strong>
              {%- if mn.status.value == 'preorder' -%}
                <a class="mn-btn" style="min-height: 4.6rem; padding: 0 2rem; font-size: 1.5rem;" href="{{ routes.root_url }}pages/preorder">Book yours</a>
              {%- elsif coming -%}
                <a class="mn-btn mn-btn--outline" style="min-height: 4.6rem; padding: 0 2rem; font-size: 1.5rem;" href="{{ p.url }}">Notify me</a>
              {%- elsif p.available and p.has_only_default_variant -%}
                {%- form 'product', p -%}
                  <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                  <button type="submit" class="mn-btn" style="min-height: 4.6rem; padding: 0 2rem; font-size: 1.5rem;">{% if mn.status.value == 'preorder' %}Pre-order{% elsif s.big %}Add to cart{% else %}Add{% endif %}</button>
                {%- endform -%}
              {%- elsif p.available -%}
                <a class="mn-btn" style="min-height: 4.6rem; padding: 0 2rem; font-size: 1.5rem;" href="{{ p.url }}">Choose</a>
              {%- else -%}
                <span class="mn-pill mn-pill--outline">Sold out</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if c.products_count > s.limit -%}<a class="mn-btn mn-btn--outline" style="align-self: flex-start;" href="{{ c.url }}">See all {{ c.products_count }} <span aria-hidden="true">→</span></a>{%- endif -%}
    {%- else -%}
      <p class="mn-note">Choose a collection for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MakerNest product cards",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (for links like #kits)" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading (else the collection title)" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "big", "label": "Large cards (for the four kits)", "default": false },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "MakerNest product cards" }]
}
{% endschema %}
