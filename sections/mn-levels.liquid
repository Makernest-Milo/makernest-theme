<section class="mn mn-dark mn-section" id="levels">
  <div class="mn-wrap" style="display: flex; flex-direction: column; gap: 3.6rem;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 2rem;">
      <h2 class="mn-h2" style="max-width: 16ch;">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="mn-muted" style="max-width: 40ch;">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="mn-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign link = b.link
          if p != blank
            assign link = p.url
          endif
          assign coming = false
          if p != blank and p.metafields.makernest.status.value == 'coming'
            assign coming = true
          endif
        -%}
        <a href="{{ link | default: '#' }}" class="mn-card mn-level-card mn-level--{{ b.level }}" {{ block.shopify_attributes }}>
          <span class="mn-mono" style="font-size: 1.2rem; letter-spacing: .1rem;">{{ b.label | upcase | escape }}</span>
          <span class="mn-name">{{ b.name | escape }}</span>
          <span class="mn-mono">{{ b.verbs | upcase | escape }}</span>
          <span class="mn-grow">{{ b.text | escape }}</span>
          <span class="mn-foot">
            <span>{%- if p != blank -%}{{ p.price | money }}{%- endif -%}</span>
            <span class="mn-pill">{% if coming %}Notify me{% elsif p != blank and p.metafields.makernest.status.value == 'preorder' %}Pre-order{% else %}{{ b.status | escape }}{% endif %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MakerNest levels",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four levels. Each starts where the last one stopped." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One level a year, starting at 10. Every level is a complete kit on its own, built on real science and real technology.</p>" }
  ],
  "blocks": [
    {
      "type": "level",
      "name": "Level",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Kit product (gives price, link and launch status)" },
        { "type": "select", "id": "level", "label": "Colour", "default": "origins", "options": [
          { "value": "origins", "label": "Origins" }, { "value": "motion", "label": "Motion" },
          { "value": "connected", "label": "Connected" }, { "value": "autonomy", "label": "Autonomy" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Level I · Electronics and sensors" },
        { "type": "text", "id": "name", "label": "Name", "default": "Origins" },
        { "type": "text", "id": "verbs", "label": "Three verbs", "default": "Sense · decide · act" },
        { "type": "text", "id": "text", "label": "One line", "default": "A machine that notices. Heat, light and sound become numbers." },
        { "type": "text", "id": "status", "label": "Status label", "default": "On sale" },
        { "type": "url", "id": "link", "label": "Link if no product is chosen" }
      ]
    }
  ],
  "presets": [{ "name": "MakerNest levels", "blocks": [{ "type": "level" }] }]
}
{% endschema %}
