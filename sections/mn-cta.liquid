{%- assign s = section.settings -%}
<section class="mn" style="padding: {% if s.boxed %}0 0 9.6rem{% else %}0{% endif %};">
  {%- if s.boxed -%}
    <div class="mn-wrap">
      <div class="mn-dark" style="border-radius: 2.8rem; padding: 4.8rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 2.8rem;">
        <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 34ch;">
          <h2 class="mn-h3">{{ s.heading | escape }}</h2>
          {%- if s.text != blank -%}<div class="mn-muted">{{ s.text }}</div>{%- endif -%}
        </div>
        <div class="mn-btns">
          {%- if s.button_1 != blank -%}<a class="mn-btn mn-btn--yellow" href="{{ s.link_1 | default: '#' }}">{{ s.button_1 | escape }}</a>{%- endif -%}
          {%- if s.button_2 != blank -%}<a class="mn-btn mn-btn--light" href="{{ s.link_2 | default: '#' }}">{{ s.button_2 | escape }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="mn-wrap" style="border-top: .2rem solid var(--mn-ink); padding-top: 2.8rem; padding-bottom: 9.6rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.6rem;">
      <div style="display: flex; flex-direction: column; gap: .6rem; max-width: 60ch;">
        <h2 class="mn-h3" style="font-size: 3.2rem;">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<div>{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if s.button_1 != blank -%}<a class="mn-btn mn-btn--outline" href="{{ s.link_1 | default: '#' }}">{{ s.button_1 | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "MakerNest call to action",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "boxed", "label": "Dark box", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every machine starts with a maker who asks \"what if?\"" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_1", "label": "First button", "default": "Buy Origins" },
    { "type": "url", "id": "link_1", "label": "First button link" },
    { "type": "text", "id": "button_2", "label": "Second button", "default": "Visit the shop" },
    { "type": "url", "id": "link_2", "label": "Second button link" }
  ],
  "presets": [{ "name": "MakerNest call to action" }]
}
{% endschema %}
