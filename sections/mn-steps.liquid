{%- assign s = section.settings -%}
<section class="mn mn-section {% if s.ground == 'tint' %}mn-tint{% endif %}" id="{{ s.anchor | default: section.id }}">
  <div class="mn-wrap mn-row">
    <div class="mn-col" style="gap: 2.8rem;">
      {%- if s.eyebrow != blank -%}<p class="mn-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="mn-h2">{{ s.heading | escape }}</h2>
      <ol class="mn-grid{% if s.image != blank or s.asset != blank %} mn-grid--two{% endif %}" style="list-style: none; margin: 0; padding: 0;">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}{% if s.image == blank and s.asset == blank %} class="mn-card mn-card--paper"{% endif %}>
            <span class="mn-mono">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><br>
            <strong style="font-size: 1.9rem;">{{ block.settings.title | escape }}</strong><br>
            {{ block.settings.text | escape }}
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if s.image != blank or s.asset != blank -%}
      <div class="mn-col mn-media mn-tint">
        {% render 'mn-img', image: s.image, asset: s.asset, width: 1400, sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1400' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MakerNest steps",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (for links like #how)", "default": "how" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How a kit works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. One machine. Fourteen builds." },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "asset", "label": "Built-in image (used when no image is picked)" },
    { "type": "select", "id": "ground", "label": "Background", "default": "paper", "options": [
      { "value": "paper", "label": "Paper" }, { "value": "tint", "label": "Yellow tint" } ] }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "One machine that grows" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Every chapter adds to the same machine on its own base board. Nothing is thrown away." }
    ] }
  ],
  "presets": [{ "name": "MakerNest steps", "blocks": [{ "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
